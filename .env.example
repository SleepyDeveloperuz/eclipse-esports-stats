# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit a real value to this file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Required: Eclipse Command Room is team-only and reads fail closed without it.
# This must be different from ADMIN_PASSWORD.
VIEWER_PASSWORD=replace-with-a-different-team-password
# At least 32 random bytes. Rotating it revokes every existing session.
SESSION_SECRET=replace-with-at-least-32-random-bytes
GIST_ID=replace-with-your-private-gist-id
GITHUB_SYNC_TOKEN=replace-with-a-github-token-that-can-update-that-gist
GEMINI_API_KEY=replace-with-your-gemini-server-key

# MLBB Meta Lab. The UI can be disabled without deleting cached data.
MLBB_META_ENABLED=true
MLBB_META_RANK=mythic
MLBB_META_DAYS=7
# Vercel Cron sends this secret as an Authorization Bearer token.
CRON_SECRET=replace-with-at-least-32-random-bytes
# Upstash Redis REST credentials for a manually managed database. The current
# Vercel Marketplace KV_REST_API_URL / KV_REST_API_TOKEN names are also accepted,
# so these two aliases are not needed when the integration injects KV_* values.
UPSTASH_REDIS_REST_URL=https://replace-with-your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
