# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit a real value to this file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Required: Eclipse Command Room is team-only and reads fail closed without it.
# This must be different from ADMIN_PASSWORD.
VIEWER_PASSWORD=replace-with-a-different-team-password
# At least 32 random bytes. Rotating it revokes every existing session.
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Team storage uses Turso when both values are set. Backup and restore select
# the same backend even when Redis credentials remain for Meta Lab caching.
# TURSO_DATABASE_URL=libsql://replace-with-your-database.turso.io
# TURSO_AUTH_TOKEN=replace-with-your-turso-token
# Optional stable backup identity; otherwise GIST_ID, then the Turso address.
# Preserve the existing identity when moving a database.
# TEAM_NAMESPACE=replace-with-existing-team-namespace
# Gist credentials are needed only for legacy migration; GIST_ID also serves
# as the namespace on existing installations. Turso-only installs may omit it.
GIST_ID=replace-with-your-private-gist-id
GITHUB_SYNC_TOKEN=replace-with-a-github-token-that-can-update-that-gist
GEMINI_API_KEY=replace-with-your-gemini-server-key

# Optional Telegram integration. Webhook POST ingestion stays disabled unless
# both the bot token and webhook secret are configured. Never expose either.
# TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Notification destination; a group ID does not grant captain authority.
# TELEGRAM_CHAT_ID=replace-with-notification-chat-id
# Positive numeric Telegram user ID of the captain. If omitted, a positive
# TELEGRAM_CHAT_ID is used for compatibility with a captain's private chat.
# TELEGRAM_CAPTAIN_USER_ID=replace-with-captain-user-id
# Comma-separated positive user IDs allowed private commands and photo uploads.
# The captain is included automatically. Usernames and roster names do not grant access.
# TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
# Human members may read commands in this team group; uploads remain private.
# TELEGRAM_GROUP_ID=-1001234567890

# MLBB Meta Lab. The UI can be disabled without deleting cached data.
MLBB_META_ENABLED=true
MLBB_META_RANK=mythic
MLBB_META_DAYS=7
# MLBB provider: rone (default) | direct | auto
MLBB_PROVIDER=rone
# Optional custom base URL for direct Moonton GMS endpoints (https only)
# MLBB_GMS_BASE_URL=https://api.gms.moontontech.com/api/gms/source/2669606
# Optional custom base URL for Rone Arena API (https only)
# RONE_BASE_URL=https://arena.rone.dev
# Vercel Cron sends this secret as an Authorization Bearer token.
CRON_SECRET=replace-with-at-least-32-random-bytes
# Upstash Redis REST credentials for a manually managed database. The current
# Vercel Marketplace KV_REST_API_URL / KV_REST_API_TOKEN names are also accepted,
# so these two aliases are not needed when the integration injects KV_* values.
UPSTASH_REDIS_REST_URL=https://replace-with-your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
